<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Roastery.Api</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- The doc comments on the contracts end up as descriptions in the document. The generator that
             does it needs both of these. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Not documenting every property of a sample contract. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
        <!-- The UI only. The document still comes from Microsoft.AspNetCore.OpenApi. -->
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
        <ProjectReference Include="..\..\src\OpenApiExamples\OpenApiExamples.csproj" />
    </ItemGroup>

</Project>
