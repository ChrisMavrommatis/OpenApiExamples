<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>OpenApiExamples</PackageId>
        <Title>OpenApiExamples</Title>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>Chris Mavrommatis</Authors>
        <PackageProjectUrl>https://github.com/ChrisMavrommatis/OpenApiExamples</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ChrisMavrommatis/OpenApiExamples</RepositoryUrl>
        <Version>1.1.0</Version>
        <PackageIcon>package_icon.png</PackageIcon>
        <AssemblyName>OpenApiExamples</AssemblyName>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <RootNamespace>OpenApiExamples</RootNamespace>
        <Description>Make your API docs actually useful. OpenApiExamples adds real request and response examples to the OpenAPI document ASP.NET Core generates for your minimal API endpoints, rendered by Swagger UI and Scalar. Write a small provider class, attach it to an endpoint with RequestExample&lt;T&gt; or ResponseExample&lt;T&gt;, and you are done. One example or many named ones, per endpoint or per route group, JSON and XML built in, any other content type through your own formatter, providers resolved from DI, and zero runtime cost because examples are written when the document is generated.</Description>
        <PackageTags>openapi;openapi-examples;swagger;swagger-ui;scalar;aspnetcore;minimal-api;api-documentation;examples;request-example;response-example;dotnet</PackageTags>
        <Copyright>Copyright (c) Chris Mavrommatis</Copyright>
        <RepositoryType>git</RepositoryType>

        <!-- Source Link ships in the SDK, so this needs no PackageReference. Symbols go up with the package:
             dotnet nuget push picks up the .snupkg sitting beside the .nupkg on its own. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <!-- Not used directly. Microsoft.AspNetCore.OpenApi 10.0.10 asks for Microsoft.OpenApi [2.0.0, ) and
             NuGet settles on 2.0.0, which has a high-severity advisory (GHSA-v5pm-xwqc-g5wc, stack overflow on
             circular $refs). The floor is open, so naming it here lifts the whole graph - and since this is a
             library, this floor becomes every consumer's floor. Drop this once Microsoft.AspNetCore.OpenApi
             raises its own floor past 2.7.5. -->
        <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\assets\package_icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    
</Project>
