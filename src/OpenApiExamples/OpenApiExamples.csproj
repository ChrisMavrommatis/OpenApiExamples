<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>OpenApiExamples</PackageId>
        <Title>OpenApiExamples</Title>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>Chris Mavrommatis</Authors>
        <PackageProjectUrl>https://github.com/ChrisMavrommatis/OpenApiExamples</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ChrisMavrommatis/OpenApiExamples</RepositoryUrl>
        <Version>1.0.2</Version>
        <PackageIcon>package_icon.png</PackageIcon>
        <AssemblyName>OpenApiExamples</AssemblyName>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <RootNamespace>OpenApiExamples</RootNamespace>
        <Description>Make your API stand out! OpenApiExamples lets you showcase real request and response samples in your OpenAPI docs with zero hassle.</Description>
        <PackageTags>openapi;examples;swagger;api-documentation;</PackageTags>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <!-- Not used directly. Microsoft.AspNetCore.OpenApi 10.0.10 asks for Microsoft.OpenApi [2.0.0, ) and
             NuGet settles on 2.0.0, which has a high-severity advisory (GHSA-v5pm-xwqc-g5wc, stack overflow on
             circular $refs). The floor is open, so naming it here lifts the whole graph - and since this is a
             library, this floor becomes every consumer's floor. Drop this once Microsoft.AspNetCore.OpenApi
             raises its own floor past 2.7.5. -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\assets\package_icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    
</Project>
